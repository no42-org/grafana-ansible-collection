---
profile: production

exclude_paths:
  - .cache/
  - .github/
  - examples/
  # ansible-galaxy's local install target. It holds a copy of this collection,
  # so leaving it in doubles every finding -- 29 of the 69 first observed.
  - .ansible/
  # ansible.cfg sets `collections_paths = ./`, so ansible-lint installs the
  # dependency collections into the repository root in CI. 4851 findings, all
  # of them in ansible.posix and community.general, none here.
  - ansible_collections/
  # roles/*/molecule/ is byte-identical to upstream by rule: the scenarios ship
  # in the collection and are never invoked, and keeping them unmodified is
  # what makes an upstream merge conflict-free. See RELEASING.md and
  # CONTRIBUTING.md. Two findings live in roles/mimir/molecule/default/ and
  # cannot be fixed without breaking that invariant.
  - roles/*/molecule/

parseable: true
verbosity: 1

use_default_rules: true

skip_list:
  - '204'  # Allow string length greater than 160 chars
  - 'no-changed-when'  # False positives for running command shells
  - 'yaml' # Disable YAML linting since it's done by yamllint
  - 'empty-string-compare'  # Allow compare to empty string
  # 22 findings, 20 of them in roles/opentelemetry_collector/defaults/main.yml.
  # The rule wants role variables prefixed with the role name, so
  # otel_collector_receivers would become opentelemetry_collector_receivers.
  #
  # Those are the role's PUBLIC interface. Renaming them breaks every playbook
  # that sets them, which is a major version bump with a deprecation path, not
  # a lint fix. Skipped because the fix is a breaking API change, not because
  # there are 22 of them.
  - 'var-naming[no-role-prefix]'
