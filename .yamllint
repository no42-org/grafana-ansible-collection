---
yaml-files:
  - "*.yaml"
  - "*.yml"
  - ".yamllint"

ignore:
  - node_modules
  # collection build output: a rewritten copy of the tree, linted at its source
  - build
  # AI tool working directory, never committed
  - openspec

extends: default

rules:
  line-length:
    max: 150
    level: warning
